# Ambiente de execucao: development | test | production
NODE_ENV=development

# Porta em que a API sobe
PORT=3333

# Conexao com o banco. SQLite: caminho relativo a pasta prisma/
DATABASE_URL="file:./dev.db"

# Chave usada para assinar os tokens JWT.
# Gere uma propria com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Tempo de validade do token. Aceita formatos como 15m, 12h, 7d
JWT_EXPIRES_IN="7d"

# Origem autorizada a consumir a API (front-end Vite)
CORS_ORIGIN="http://localhost:5173"
